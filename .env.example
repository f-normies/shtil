# Скопируйте в .env и заполните строки с <...>. Секреты генерируются командами в комментариях.
# .env не коммитится.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=compass
# openssl rand -hex 16
POSTGRES_PASSWORD=<пароль Postgres>
POSTGRES_DB=compass
# Тот же пароль, что в POSTGRES_PASSWORD.
COMPASS_DATABASE_URL=postgresql+asyncpg://compass:<пароль Postgres>@postgres:5432/compass

# --- Хранилище S3 (RustFS) ----------------------------------------------------
# Ключи задаются здесь, RustFS создаёт с ними учётную запись при первом запуске.
S3_ACCESS_KEY=shtil
# openssl rand -hex 24
S3_SECRET_KEY=<секрет S3>
COMPASS_S3_ENDPOINT_URL=http://rustfs:9000
COMPASS_S3_ACCESS_KEY=shtil
COMPASS_S3_SECRET_KEY=<секрет S3>
COMPASS_S3_BUCKET=compass-audio
COMPASS_S3_REGION=us-east-1

# --- Приложение ---------------------------------------------------------------
# local: cookie без флага Secure, кабинеты работают по HTTP. На нашем стенде было stand + HTTPS.
COMPASS_ENVIRONMENT=local
# Ключ HMAC для лимитов частоты входа, не короче 32 символов: openssl rand -hex 32
COMPASS_THROTTLE_SECRET=<секрет лимитов>
# Адрес контейнера web в сети compose. Только ему api верит в заголовке X-Forwarded-For.
COMPASS_TRUSTED_PROXIES=10.88.0.10
# Пароль всех пользователей сида (make seed / cli seed).
COMPASS_SEED_PASSWORD=<пароль демо-пользователей>
COMPASS_TIMEZONE=Europe/Moscow
# Шаги эскалации критического сигнала, минуты. Для быстрой проверки — 1,2,3.
COMPASS_ESCALATION_MINUTES=15,30,60

# --- Модели (профиль gpu) -------------------------------------------------------
# Адреса сервисов моделей в сети compose. Пустое значение — роль выключена,
# приложение работает без неё, а AI-функции этой роли отвечают ошибкой.
COMPASS_LLM_URLS=http://llm:8000
COMPASS_EMBEDDINGS_URLS=http://embeddings:8001
COMPASS_ASR_URLS=http://asr:8002
COMPASS_DOCPARSE_URLS=http://docparse:8003
COMPASS_RERANK_URLS=http://rerank:8004
# Токен Hugging Face нужен, только если скачивание моделей упирается в лимиты.
HF_TOKEN=
# Номера видеокарт (nvidia-smi). LLM_GPU — для LLM, AUX_GPU — для эмбеддингов, ранжировщика
# и olmOCR. На одной карте оба 0. Раскладка и доли памяти — docs/models.md.
LLM_GPU=0
AUX_GPU=0
# Доля памяти карты LLM_GPU, которую забирает vLLM. 0.55 оставляет место остальным моделям
# на той же карте 80 ГБ. Если у LLM своя карта — 0.92 (значение vLLM по умолчанию).
LLM_GPU_MEMORY_UTILIZATION=0.55
# Compute capability карты для сборки llama.cpp: 80 — A100, 86 — A10/RTX 30, 89 — L4/L40S/RTX 40,
# 90 — H100. default собирает под девять архитектур, это 30–60 минут вместо 10–15.
CUDA_DOCKER_ARCH=default

# --- Порты на хосте -------------------------------------------------------------
WEB_PORT=8080
GRAFANA_PORT=3000
# Пароль admin в Grafana: openssl rand -hex 16. Применяется при первом запуске.
GRAFANA_ADMIN_PASSWORD=<пароль Grafana>
